# Environment Configuration for Extension Guard

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/extension_guard?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="change-this-to-a-secure-random-string-in-production"

# Engine Parameters
FRONTEND_URL="http://localhost:5173"
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR="/tmp/extension-guard/uploads"
ANALYZER_TIMEOUT_MS=300000
SANDBOX_TIMEOUT_MS=600000
LOG_LEVEL="info"

# Python Interpreter (optional override)
# PYTHON_PATH="python"
