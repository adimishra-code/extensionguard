# Environment Configuration for Extension Guard

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/extension_guard?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Engine Parameters
FRONTEND_URL="http://localhost:5173"
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR="/tmp/extension-guard/uploads"
ANALYZER_TIMEOUT_MS=300000
SANDBOX_TIMEOUT_MS=600000
LOG_LEVEL="info"
ANALYZER_VERSION="1.0.0"
RULESET_VERSION="1.0.0"

# Python Interpreter (optional override)
# PYTHON_PATH="python"

# LLM Security Assessment Engine (Optional - falls back to deterministic heuristic reasoner if unset)
# Option 1: Google Gemini (Free: 15 RPM / 1,500 RPD)
GEMINI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# Option 2: OpenRouter (Flexible multi-model routing with high rate limits)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Option 3: OpenAI
OPENAI_API_KEY=""

# Email Verification & Password Reset (Nodemailer SMTP)
# Option A: Gmail (Recommended — create 16-character App Password at myaccount.google.com/apppasswords)
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="ExtensionGuard Security <your-email@gmail.com>"

# Option B: Custom SMTP (Brevo / SendGrid / Amazon SES)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-login"
# SMTP_PASS="your-smtp-key"
# SMTP_SECURE=false
# SMTP_FROM="ExtensionGuard <security@yourdomain.com>"


